{
  "name": "companion",
  "private": true,
  "version": "0.1.0",
  "description": "Companion \u2014 a maintainer's GUI that manages GitHub repositories with AI agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "acl": "node scripts/acl.mjs",
    "build": "pnpm gen:modules && pnpm -r build",
    "dev": "pnpm gen:modules && pnpm --parallel --filter companion-api --filter companion-web dev",
    "gen:modules": "node scripts/gen-modules.mjs",
    "postinstall": "node scripts/gen-modules.mjs",
    "prod": "pnpm build && pm2 startOrRestart ecosystem.config.cjs",
    "release:dependencies": "node scripts/publish-packages.mjs --check-built-imports",
    "release:packages": "node scripts/publish-packages.mjs",
    "release:target": "node scripts/release-target.mjs",
    "security:workflow-policy": "node scripts/security-workflow-policy.mjs",
    "sdk:surface": "node scripts/sdk-surface.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm gen:modules && pnpm -r typecheck",
    "version:check": "node scripts/version.mjs --check"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
