    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@companion/contracts": "workspace:*",
    "@companion/types": "workspace:*",
    "jsonrepair": "^3.15.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
