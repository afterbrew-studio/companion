{
  "name": "@moxxy/companion-types",
  "version": "0.5.4",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "description": "Internal Companion framework package. Modules import @moxxy/companion-sdk instead.",
  "keywords": [
    "github",
    "ai",
    "agents",
    "moxxy",
    "types"
  ],
  "homepage": "https://github.com/moxxy-ai/companion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxxy-ai/companion.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/moxxy-ai/companion/issues"
  }
}
