{
  "name": "@moxxy/companion-contracts",
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@moxxy/companion-types": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "description": "The open registries Companion modules augment, and the cross-boundary envelopes.",
  "keywords": [
    "github",
    "ai",
    "agents",
    "moxxy",
    "contracts"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/moxxy-ai/companion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxxy-ai/companion.git",
    "directory": "packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/moxxy-ai/companion/issues"
  }
}
