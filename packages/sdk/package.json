{
  "name": "@moxxy/companion-sdk",
  "version": "0.7.5",
  "description": "The public module-authoring surface for Companion.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "default": "./dist/agents.js"
    },
    "./client": {
      "source": "./src/client.tsx",
      "types": "./dist/types/client.d.ts"
    },
    "./ui": {
      "source": "./src/ui.ts",
      "types": "./dist/types/ui.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "src/index.ts",
    "src/client.tsx",
    "src/ui.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@moxxy/companion-core": "workspace:*",
    "@moxxy/companion-services": "workspace:*",
    "@moxxy/companion-types": "workspace:*",
    "@moxxy/companion-ui": "workspace:*",
    "@moxxy/companion-contracts": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@moxxy/companion-contracts": "^0.5.2",
    "react": "^18.3.1"
  },
  "sideEffects": false,
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxxy-ai/companion.git",
    "directory": "packages/sdk"
  }
}
