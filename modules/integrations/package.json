{
  "name": "@companion/module-integrations",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./manifest": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./contract": {
      "source": "./src/contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./provider": {
      "source": "./src/api/provider.ts",
      "types": "./dist/api/provider.d.ts",
      "default": "./dist/api/provider.js"
    },
    "./client": {
      "source": "./src/client/index.tsx"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@moxxy/companion-contracts": "workspace:*",
    "@companion/module-core": "workspace:*",
    "@companion/module-workspace": "workspace:*",
    "@moxxy/companion-sdk": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@moxxy/companion-services": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "sideEffects": false
}
