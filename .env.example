# Companion authentication — copy to .env (repo root or ~/.companion/.env).
# Precedence: real environment > ./.env > ~/.companion/.env.
# These accounts are SEEDS: imported once into an empty user store, after
# which the Users admin module owns accounts. A clean setup without any .env
# credentials runs first-boot onboarding in the browser instead.
# An account is seeded only when BOTH its USER and PASSWORD are set.

# A clean password-mode install generates an owner-only, one-time bootstrap
# token at $COMPANION_HOME/bootstrap-token. Prefer that browser ceremony. For
# unattended provisioning, supply a random value of at least 32 characters;
# it is accepted only while the user store is empty.
#COMPANION_BOOTSTRAP_TOKEN=replace-with-a-random-one-time-capability

# Optional admin seed — full access (settings, workspaces, everything below).
# Defining USER + PASSWORD skips the bootstrap ceremony. Never deploy the
# example password; these values are imported only while the user store is empty.
#COMPANION_ADMIN_USER=admin
#COMPANION_ADMIN_EMAIL=admin@example.com
#COMPANION_ADMIN_PASSWORD=change-me

# Maintainer — day-to-day operation: issues, PRs, proposals, pipelines,
# runs, automations. No instance settings / workspace lifecycle.
#COMPANION_MAINTAINER_USER=maintainer
#COMPANION_MAINTAINER_EMAIL=maintainer@example.com
#COMPANION_MAINTAINER_PASSWORD=change-me

# Business — proposals only (create, analyze, follow along).
#COMPANION_BUSINESS_USER=business
#COMPANION_BUSINESS_EMAIL=business@example.com
#COMPANION_BUSINESS_PASSWORD=change-me

# Optional overrides.
#COMPANION_PORT=8901
# Bind host. Defaults to 127.0.0.1 for local runs; Docker Compose sets 0.0.0.0.
#COMPANION_HOST=127.0.0.1
# Password is the daemon/Docker default. The npx CLI writes local mode only for
# its loopback developer experience; never combine local with a network bind.
#COMPANION_AUTH_MODE=password
# Required for Secure browser cookies and generated external links behind TLS.
#COMPANION_PUBLIC_URL=https://companion.example.com

# AES-256 key for credentials stored by the default SQLite SecretStore. Leave
# both unset for a local owner-only key at $COMPANION_HOME/secret-key. In a
# managed deployment, mount a 32-byte base64url/64-hex value outside the data
# volume and back it up separately from the database.
#COMPANION_SECRET_KEY_FILE=/run/secrets/companion-secret-key
#COMPANION_SECRET_KEY=base64url-or-64-hex-encoded-32-byte-key

# GitHub Enterprise Server: point both at your install. Defaults are github.com.
# apiUrl must include the path GHES serves its API under.
# COMPANION_GITHUB_API_URL=https://ghe.corp/api/v3
# COMPANION_GITHUB_HOST=ghe.corp

# Egress proxy: set either and the daemon routes outbound requests through it.
# HTTPS_PROXY=http://proxy.corp:3128
# NO_PROXY=127.0.0.1,.internal
# Built-in webhook delivery fails closed through a proxy unless the proxy is
# independently configured to reject private/reserved destinations and this
# acknowledgement is set.
# COMPANION_TRUST_EGRESS_PROXY=1
